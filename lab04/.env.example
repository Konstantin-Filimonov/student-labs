# Скопируйте в .env и заполните. Файл .env в репозиторий НЕ коммитить (он в .gitignore).

# --- Общий сервер по умолчанию: LM Studio (Developer -> Start Server) ---
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=lm-studio

# --- Оцениваемые модели (точные имена, как в LM Studio: GET /v1/models) ---
MODEL_A=
MODEL_B=
# Судья — ДОЛЖЕН отличаться от A и B (п. 4.8 методички)
MODEL_JUDGE=

# Если модель облачная — можно задать отдельный сервер и ключ для неё:
# MODEL_B_BASE_URL=https://api.provider.example/v1
# MODEL_B_API_KEY=
# Цены за 1 млн токенов (для локальных моделей оставьте пустыми — стоимость не считается)
# MODEL_B_PRICE_IN=
# MODEL_B_PRICE_OUT=
# PRICE_CURRENCY=USD
# PRICE_DATE=
# PRICE_SOURCE=

# --- Параметры генерации (одинаковые для A и B) ---
TEMPERATURE=0.2
MAX_TOKENS=1024
# MAX_TOKENS_PARAM=max_completion_tokens   # если облачный API не принимает max_tokens
# SEED=
REQUEST_TIMEOUT=180
STRUCTURED_OUTPUT=0
JUDGE_TEMPERATURE=0.0

# --- Параметры эксперимента ---
N_HARD=5
N_REPEATS=3
MANUAL_N=10
SAMPLE_SEED=42
BOOTSTRAP_N=2000
