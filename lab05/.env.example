# Скопируйте этот файл в .env и при необходимости поправьте значения.
# Реальных ключей здесь нет: LM Studio не требует API-ключа для локального сервера.

# Адрес локального сервера LM Studio (вкладка Developer -> Start Server)
LMSTUDIO_URL=http://localhost:1234

# Идентификатор модели в LM Studio (см. вкладку Developer / ответ GET /v1/models).
# Если оставить пустым или указать неточно - программа попробует найти Qwen2.5 3B сама.
MODEL_NAME=qwen2.5-3b-instruct

# Параметры эксперимента
BENCH_RUNS=5
BENCH_MAX_TOKENS=300
TEMPERATURE=0.2
REQUEST_TIMEOUT=300

# Заполнить вручную для отчёта (API это не отдаёт): версия LM Studio из About
LMSTUDIO_VERSION=
